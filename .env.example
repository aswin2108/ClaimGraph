# Optional overrides for docker-compose.yml. Copy to .env (git-ignored) to use.
# The Gemini key does NOT go here: put API_Gemini=... in Secrets/.env (also git-ignored).

# Host ports (all bound to 127.0.0.1)
WEB_PORT=5173
API_PORT=8080
FALKORDB_PORT=6379
FALKORDB_BROWSER_PORT=3000

# Agent (LLM) controls
AGENT_ENABLED=true
AGENT_MAX_RUNS_PER_HOUR=30
AGENT_DAILY_TOKEN_BUDGET=1000000
# AGENT_MODEL=gemini-3.8-flash
